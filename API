    <title>Menu UMKM F&B</title>
    <!-- 1. Panggil API/CDN Google Material Symbols -->
    <link rel="stylesheet" href="https://googleapis.com" />
    
    <style>
        /* Mengubah warna & ukuran ikon agar estetik */
        .icon-fnb {
            font-family: 'Material Symbols Outlined';
            font-size: 48px;
            color: #ff6b6b; /* Warna pastel merah muda */
            background-color: #ffe5e5; /* Background lingkaran pastel */
            padding: 10px;
            border-radius: 50%;
        }
    </style>
</head>
<body>

    <!-- 2. Panggil ikon F&B berdasarkan nama teksnya -->
